<?xml version="1.0" encoding="utf-8"?>
<!-- Safe publish profile: publishes to a local folder. It contains no secrets and no server names.
     Copy the output folder to the IIS site folder (see IIS-HOSTING.md). -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <publishUrl>bin\Release\Publish</publishUrl>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <ExcludeApp_Data>True</ExcludeApp_Data>
    <ExcludeFilesFromDeployment>App_Data\secrets.config</ExcludeFilesFromDeployment>
    <EnableMSDeployAppOffline>False</EnableMSDeployAppOffline>
  </PropertyGroup>
</Project>
