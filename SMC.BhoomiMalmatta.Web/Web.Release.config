<?xml version="1.0" encoding="utf-8"?>
<!-- Release transformation: no debug, errors hidden from users, secure cookies, no secrets. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <authentication><forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" /></authentication>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite" xdt:Transform="SetAttributes(mode,defaultRedirect,redirectMode)" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" xdt:Transform="SetAttributes" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="PassThrough" xdt:Transform="SetAttributes(errorMode,existingResponse)" />
  </system.webServer>
  <!-- Set the real storage / log folders in IIS Manager (Configuration Editor) or via the deployment pipeline, for example:
  <appSettings>
    <add key="Storage.Root" value="D:\SMC_Data\Uploads" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Log.Root" value="D:\SMC_Data\Logs" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings> -->
</configuration>
