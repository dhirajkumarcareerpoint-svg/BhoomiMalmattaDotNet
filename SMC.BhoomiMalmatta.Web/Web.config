<?xml version="1.0" encoding="utf-8"?>
<!-- No secrets in this file. SMS credentials come from environment variables (SMC_SMS_USERNAME / SMC_SMS_PASSWORD)
     or from the optional, git-ignored App_Data\secrets.config (see App_Data\secrets.config.example). -->
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!-- Existing database only. Windows Authentication. The application refuses to start if the database is not exactly SMC_BhoomiMalmatta. -->
    <add name="SmcDatabase" providerName="System.Data.SqlClient"
         connectionString="Server=localhost;Database=SMC_BhoomiMalmatta;Integrated Security=SSPI;TrustServerCertificate=True;Application Name=SMC.BhoomiMalmatta.Web;Connect Timeout=15" />
  </connectionStrings>

  <appSettings file="App_Data\secrets.config">
    <add key="webpages:Enabled" value="false" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="Storage.Root" value="%LOCALAPPDATA%\SMC_BhoomiMalmatta\Uploads" />
    <add key="Log.Root" value="%LOCALAPPDATA%\SMC_BhoomiMalmatta\Logs" />
    <add key="Auth.TimeoutMinutes" value="20" />
    <add key="Auth.CitizenTimeoutDays" value="30" />
    <add key="Numbering.Separator" value="" />
    <add key="UseDevanagariDigits" value="true" />
    <add key="Sms.Enabled" value="false" />
    <add key="Sms.Provider" value="ACL" />
    <add key="Sms.BaseUrl" value="https://push3.aclgateway.com/servlet/com.aclwireless.pushconnectivity.listeners.TextListener" />
    <add key="Sms.SenderId" value="MAHGOV" />
    <add key="Sms.CountryCode" value="91" />
    <!-- ACL query-parameter names are configurable because they are not published in this repository. Verify with your ACL account manual. -->
    <add key="Sms.Param.Username" value="username" />
    <add key="Sms.Param.Password" value="password" />
    <add key="Sms.Param.To" value="to" />
    <add key="Sms.Param.From" value="from" />
    <add key="Sms.Param.Text" value="text" />
    <add key="Sms.Param.TemplateId" value="dltTemplateId" />
    <add key="Payment.Mode" value="Manual" />
    <add key="Payment.Instructions" value="१. QR स्कॅन करून वरील रक्कम भरा. २. UTR / संदर्भ क्रमांक आणि भरणा दिनांक नोंदवा. ३. पावतीचा स्पष्ट फोटो किंवा PDF जोडा. ४. भरणा पडताळणीसाठी सादर करा दाबा." />
    <add key="Payment.QrImagePath" value="~/Content/payment/qr.png" />
    <!-- false (default): the Assistant Commissioner sees only "Approve"; ACReturn / ACReject are refused by the server. true: Return to OS / Reject come back. -->
    <add key="Workflow.AcAllowReturnReject" value="false" />
    <!-- false (default): the application wizard and POST api/v1/applications do not ask for / require applicant name, mobile and e-mail (a separate form will supply them). true: the "अर्जदार" block is shown and name + mobile are required. -->
    <add key="Apply.CollectApplicantDetails" value="false" />
    <!-- Properties page: MR_AST_MasterData groups that hold the property type / status lists (empty Ward/Zone group = the values stored in MR_AST_Properties). -->
    <add key="Properties.CategoryGroup" value="PropertyCategory" />
    <add key="Properties.StatusGroup" value="PropertyStatus" />
    <add key="Properties.WardGroup" value="" />
    <add key="Properties.ZoneGroup" value="" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" executionTimeout="120" enableVersionHeader="false" requestValidationMode="4.5" />
    <globalization culture="mr-IN" uiCulture="mr-IN" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <!-- requireSSL is false ONLY so local development over http://localhost works. Web.Release.config sets it to true, and the application
         refuses to start in release mode (compilation debug off) unless forms requireSSL is true. -->
    <authentication mode="Forms">
      <forms name=".SMC.Auth" loginUrl="~/Login.aspx" timeout="20" slidingExpiration="true" requireSSL="false" cookieless="UseCookies" protection="All" path="/" />
    </authentication>
    <authorization><allow users="*" /></authorization>
    <sessionState mode="InProc" cookieName="SMC.Session" timeout="20" cookieless="false" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Always" controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
    <customErrors mode="Off" />
    <trace enabled="false" />
  </system.web>

  <!-- Anonymous access: only the home page, login, status lookup, application form, health and static files. -->
  <location path="Citizen">
    <system.web><authorization><allow roles="Citizen" /><deny users="*" /></authorization></system.web>
  </location>
  <location path="Department">
    <system.web><authorization><allow roles="Admin,JE,OS,AssistantCommissioner,Staff" /><deny users="*" /></authorization></system.web>
  </location>
  <location path="Department/Properties.aspx"><system.web><authorization><allow roles="Admin" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Calculations.aspx"><system.web><authorization><allow roles="Admin" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Recovery.aspx"><system.web><authorization><allow roles="Admin" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Transfers.aspx"><system.web><authorization><allow roles="Admin" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Tenders.aspx"><system.web><authorization><allow roles="Admin" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Schemes.aspx"><system.web><authorization><allow roles="Admin" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Users.aspx"><system.web><authorization><allow roles="Admin,Staff" /><deny users="*" /></authorization></system.web></location>
  <location path="Department/Masters.aspx"><system.web><authorization><allow roles="Admin,Staff" /><deny users="*" /></authorization></system.web></location>
  <location path="App_Data"><system.web><authorization><deny users="*" /></authorization></system.web></location>
  <location path="Apply.aspx">
    <system.web><httpRuntime maxRequestLength="44032" executionTimeout="300" /></system.web>
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="45088768" /></requestFiltering></security></system.webServer>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
        <!-- 'unsafe-inline' scripts are required by classic Web Forms postback / validator scripts. -->
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="8388608" />
        <hiddenSegments><remove segment="App_Data" /><add segment="App_Data" /></hiddenSegments>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly><assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Web.Http.WebHost" publicKeyToken="31bf3856ad364e35" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" /></dependentAssembly>
    </assemblyBinding>
  </runtime>

  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
    <!-- Database initialization is DISABLED: EF never creates, alters, drops or migrates anything. -->
    <contexts>
      <context type="SMC.BhoomiMalmatta.Data.SmcDbContext, SMC.BhoomiMalmatta.Data" disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
</configuration>
