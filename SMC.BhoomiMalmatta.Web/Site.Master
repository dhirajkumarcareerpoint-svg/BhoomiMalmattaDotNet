<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="SMC.BhoomiMalmatta.Web.SiteMaster" %>
<!DOCTYPE html><html lang="mr"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>भूमी व मालमत्ता व्यवस्थापन प्रणाली - सोलापूर महानगरपालिका</title><link href="<%= ResolveUrl("~/Content/css/site.css") %>" rel="stylesheet" /><link href="<%= ResolveUrl("~/Content/css/app.css") %>" rel="stylesheet" /></head><body><form id="form1" runat="server">
<asp:PlaceHolder ID="phSiteHeader" runat="server"><header class="grad"><span class="emb sm" aria-hidden="true">🏛</span><span><b>सोलापूर महानगरपालिका</b><br /><small>भूमी व मालमत्ता व्यवस्थापन प्रणाली</small></span><span class="sp"></span><asp:PlaceHolder ID="phPublic" runat="server"><a class="ib" href="~/Default.aspx" runat="server">मुख्यपृष्ठ</a><a class="ib" href="~/Login.aspx" runat="server">Officer Login</a></asp:PlaceHolder><asp:PlaceHolder ID="phCitizen" runat="server" Visible="false"><a class="ib" href="~/Citizen/Dashboard.aspx" runat="server">माझा अर्ज</a></asp:PlaceHolder><asp:PlaceHolder ID="phUser" runat="server" Visible="false"><span><asp:Literal ID="litUser" runat="server" /></span><asp:LinkButton ID="lnkLogout" runat="server" CssClass="ib" CausesValidation="false" OnClick="lnkLogout_Click">बाहेर पडा</asp:LinkButton></asp:PlaceHolder></header></asp:PlaceHolder>
<asp:PlaceHolder ID="phAdminLinks" runat="server" Visible="false"><nav class="admin-links" aria-label="विभाग दुवे"><a href="~/Department/Applications.aspx" runat="server">मागणी अर्ज</a><a href="~/Department/AuditLogs.aspx" runat="server">Audit log</a><a href="~/Department/Reports.aspx" runat="server">Reports</a><a href="~/Department/Users.aspx" runat="server">Users</a><a href="~/Department/Masters.aspx" runat="server">Master data</a><asp:PlaceHolder ID="phNavUser" runat="server" Visible="false"><span class="admin-links-user"><asp:Literal ID="litNavUser" runat="server" /></span><asp:LinkButton ID="lnkNavLogout" runat="server" CssClass="admin-links-logout" CausesValidation="false" OnClick="lnkLogout_Click">बाहेर पडा</asp:LinkButton></asp:PlaceHolder></nav></asp:PlaceHolder>
<main id="mainContent" runat="server"><div class="wrap"><asp:Panel ID="pnlNotice" runat="server" Visible="false" role="status"><asp:Literal ID="litNotice" runat="server" /></asp:Panel><asp:ContentPlaceHolder ID="cphMain" runat="server" /></div></main><script>window.SMC_BASE = '<%= HttpRuntime.AppDomainAppVirtualPath == "/" ? "" : HttpRuntime.AppDomainAppVirtualPath %>';</script><script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script></form></body></html>